!uploads/pdf/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
*.faiss
faiss_index/

# ---- AI model caches ----
.cache/
models_cache/
.EasyOCR/

# ---- editor / OS ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
