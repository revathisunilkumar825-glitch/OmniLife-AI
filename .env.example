# Copy this file to .env and fill in real values.  NEVER commit .env to GitHub.

# SQLite (default, nothing to install):
DATABASE_URL=sqlite:///database/app.db
# PostgreSQL instead (also: pip install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://omnilife:change_me@localhost:5432/omnilife

# JWT signing secret - generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Where uploaded files are stored
UPLOAD_DIR=uploads

# Ollama (Member 3) - local LLM server
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Only used by docker-compose when you enable the postgres profile
POSTGRES_PASSWORD=change_me
